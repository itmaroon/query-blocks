#. Plugin Name of the plugin
#: query-blocks.php
msgid "Query Blocks"
msgstr ""

#. Plugin URI of the plugin
#: query-blocks.php
msgid "https://itmaroon.net"
msgstr ""

#. Description of the plugin
#: query-blocks.php
msgid "A collection of blocks that display WordPress posts"
msgstr "WordPressの投稿を表示させるためのブロックを集めました。"

#. Author of the plugin
#: query-blocks.php
msgid "Web Creator ITmaroon"
msgstr "WebクリエイターITmaroon"

#: build/blocks/post-crumbs/index.js:1
msgid ""
"This block displays the selection status of post data in breadcrumb format."
msgstr "このブロックは、投稿データの選択状態をパンくず形式で表示します。"

#: build/blocks/post-crumbs/index.js:1
msgid "Product"
msgstr "作品"

#: build/blocks/post-crumbs/index.js:1 build/blocks/post-filter/index.js:1
msgid "Linked Post Block"
msgstr "投稿ブロックとのリンク"

#: build/blocks/post-crumbs/index.js:1 build/blocks/post-filter/index.js:1
#: build/blocks/post-pagenation/index.js:1
msgid "Select Pickup Posts Block"
msgstr "投稿ブロックの選択"

#: build/blocks/post-crumbs/index.js:1 build/blocks/post-filter/index.js:1
#: build/blocks/post-pagenation/index.js:1
msgid "Select a block"
msgstr "ブロックを選択"

#: build/blocks/post-filter/index.js:1
msgid "Search"
msgstr "検索"

#: build/blocks/post-filter/index.js:1
msgid "Date"
msgstr "期間"

#: build/blocks/post-filter/index.js:1
msgid ""
"This block provides users with the ability to set filters such as category "
"and date for the Post Block."
msgstr ""
"このブロックにより、ユーザーは投稿データにカテゴリや日付などのフィルターを設"
"定できます。"

#: build/blocks/post-filter/index.js:1
msgid "The string you want to search for..."
msgstr "検索したい文字列を入力..."

#: build/blocks/post-filter/index.js:1
msgid "Product Category"
msgstr "作品カテゴリ"

#: build/blocks/post-filter/index.js:1
msgid "Filter Item Setting"
msgstr "フィルタアイテムの設定"

#: build/blocks/post-filter/index.js:1
msgid "Date filter Setting"
msgstr "期間フィルタの設定"

#: build/blocks/post-filter/index.js:1
msgid "Search filter Setting"
msgstr "検索フィルタの設定"

#: build/blocks/post-filter/index.js:1
msgid "Custom fields to select"
msgstr "カスタムフィールドの選択"

#: build/blocks/post-filter/index.js:1 build/blocks/post-filter/index.js:2
msgid "Year"
msgstr "年"

#: build/blocks/post-filter/index.js:1
msgid "Month"
msgstr "月"

#: build/blocks/post-filter/index.js:1
msgid "Day"
msgstr "日"

#: build/blocks/post-filter/index.js:1 build/blocks/post-filter/index.js:2
msgid "Start of period"
msgstr "始期"

#: build/blocks/post-filter/index.js:1 build/blocks/post-filter/index.js:2
msgid "End of period"
msgstr "終期"

#. translators: %1$d: number of choices, %2$d: maximum
#: build/blocks/post-filter/index.js:2
msgid ""
"This period makes %1$d choices. Only the first %2$d are shown. Please narrow "
"the period."
msgstr ""
"この期間では選択肢が %1$d 個になります。先頭の %2$d 個だけを表示します。期間"
"を絞ってください。"

#: build/blocks/post-filter/index.js:2
msgid "Taxonomy Setting"
msgstr "タクソノミーの設定"

#. translators: %s: name of the taxonomy (for example "Creator").
#: build/blocks/post-filter/view.js:3
msgid ""
"No choices are shown for \"%s\" because this taxonomy has no terms yet. Add "
"terms and assign them to posts, and the choices appear here."
msgstr ""
"このタクソノミーにはまだタームがないため、\"%s\"の選択肢は表示されません。"
"タームを追加して投稿に割り当てると、ここに選択肢が表示されるようになります。"

#: build/blocks/post-pagenation/index.js:1
msgid ""
"This block displays pagination. It works in conjunction with the Post Block "
"to switch pages."
msgstr ""
"このブロックはページネーションを表示します。投稿ブロックと連動してページを切"
"り替えます。"

#: build/blocks/post-pagenation/index.js:1
msgid "Back"
msgstr "前へ"

#: build/blocks/post-pagenation/index.js:1
msgid "Forward"
msgstr "次へ"

#: build/blocks/post-pagenation/index.js:1
msgid "Block Display Settings"
msgstr "ブロック表示設定"

#: build/blocks/post-pagenation/index.js:1
msgid "Display Type"
msgstr "表示タイプ"

#: build/blocks/post-pagenation/index.js:1
msgid "Page Num"
msgstr "ページ番号"

#: build/blocks/post-pagenation/index.js:1
msgid "Back Foward"
msgstr "前後ボタン"

#: build/blocks/post-pagenation/index.js:1
msgid "Is Arrow Button"
msgstr "矢印ボタン"

#: build/blocks/post-pagenation/index.js:1
msgid "Page Button Number"
msgstr "番号ボタンの表示数"

#: build/blocks/post-pickup/index.js:1
msgid "There were no relevant articles."
msgstr "対象となる投稿がありません。"

#: build/blocks/post-pickup/index.js:1
msgid ""
"This block picks up and displays articles that you want to draw attention to."
msgstr "このブロックは、注目したい投稿をピックアップして表示します。"

#: build/blocks/post-pickup/index.js:1
msgid "Content Settings"
msgstr "内容の設定"

#: build/blocks/post-pickup/index.js:1
msgid "Pickup ID"
msgstr "投稿ブロックのID"

#: build/blocks/post-pickup/index.js:1
msgid "Select Post Type"
msgstr "投稿タイプの選択"

#: build/blocks/post-pickup/index.js:1
msgid "Select Query Type"
msgstr "クエリータイプの選択"

#: build/blocks/post-pickup/index.js:1
msgid "Nomal"
msgstr "通常"

#: build/blocks/post-pickup/index.js:1
msgid "Popular"
msgstr "人気記事"

#: build/blocks/post-pickup/index.js:1
msgid "Pickup Post Type"
msgstr "ピックアップの投稿タイプ"

#: build/blocks/post-pickup/index.js:1
msgid "Muluti Post"
msgstr "複数投稿"

#: build/blocks/post-pickup/index.js:1
msgid "Single Post"
msgstr "単独投稿"

#: build/blocks/post-pickup/index.js:1
msgid "Choice Taxsonomy"
msgstr "タクソノミーの選択"

#: build/blocks/post-pickup/index.js:1
msgid "The relationship between taxonomies"
msgstr "タクソノミーの牽連関係"

#: build/blocks/post-pickup/index.js:1
msgid "Choice Field"
msgstr "フィールドの選択"

#: build/blocks/post-pickup/index.js:1
msgid "Display Num"
msgstr "表示する投稿数"

#: build/blocks/post-pickup/index.js:1
msgid "Unit Style Copy&Past"
msgstr "ユニットスタイルのコピー・貼付"

#: build/blocks/post-pickup/index.js:1
msgid "Copy"
msgstr "コピー"

#: build/blocks/post-pickup/index.js:1
msgid "wait"
msgstr "処理中"

#: build/blocks/post-pickup/index.js:1
msgid "Paste"
msgstr "貼付け"

#: build/blocks/post-pickup/index.js:1
msgid "Check the unit to which you want to paste and press the Paste button."
msgstr "貼り付けたいユニットをチェックして、「貼り付け」ボタンを押します。"

#: build/blocks/post-pickup/index.js:1
msgid "Paste to"
msgstr "貼付け先"

#. translators: %s: block titles
#: build/blocks/post-pickup/index.js:2
msgid ""
"%s cannot be placed here. The contents of this block are the template for "
"one post and are repeated for each post. Please move it outside this block."
msgstr ""
"%s は、ここには置けません。このブロックの中身は投稿1件分のひな型で、投稿の数"
"だけ繰り返されます。このブロックの外へ移動してください。"

#: build/blocks/post-pickup/view.js:1
msgid "There is no image set."
msgstr "画像がセットされていません。"

